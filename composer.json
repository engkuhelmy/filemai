{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "engkuhelmy/filemai",
    "type": "project",
    "description": "Filemai.my - Vertical mini-drama streaming platform with YouTube episode module & interstitial ad-gated player.",
    "keywords": ["laravel", "framework", "streaming", "drama", "youtube", "interstitial-ads"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
